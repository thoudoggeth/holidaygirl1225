{
  "name": "doggosblog",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./doggo's blog_files",
    "binding": "ASSETS"
  },
  "main": "index.js",
  "routes": [
    {
      "pattern": "*.thydoggeth.xyz/*",
      "zone_name": "thydoggeth.xyz"
    }
  ],
  "observability": {
    "enabled": true
  }
}
