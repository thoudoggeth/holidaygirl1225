document.addEventListener("DOMContentLoaded", function () {
    const player = document.getElementById("music-player");
    const title = document.getElementById("title");
    const image = document.getElementById("cd-image");
    const pause_button = document.getElementById("play-pause");

    const songs = [
        ["door.mp3", "Spring Cleaning - Deltarune Chapter 2 OST: 02 - Girl Next Door", "cover.png"],
        ["distance.mp3", "Deltarune Chapter 3+4 OST: 46 - The distance between two", "cover.png"],
        ["findher.mp3", "Deltarune OST: ?? - Find Her", "cover.png"],
        ["raisebat.mp3", "Deltarune Chapter 3+4 OST: 20 - Raise Up Your Bat", "cover.png"],
        ["festival.mp3", "Deltarune Chapter 5 OST: 5 - Festival", "cover.png"]
    ];
    let index = 0;
    const count = songs.length;

    function loadTrack(i) {
        player.src = "audio/tracks/" + songs[i][0];
        title.innerHTML = songs[i][1];
        image.src = "audio/covers/" + songs[i][2];
    }

    function skip(x) {
        index = (index + x + count) % count; // safer than manual wraparound
        loadTrack(index);
        player.load();
        player.play().catch(err => console.warn("Playback failed:", err));
        pause_button.innerHTML = "||";
    }

    function play_pause() {
        if (player.paused) {
            player.play().catch(err => console.warn("Playback failed:", err));
            pause_button.innerHTML = "||";
        } else {
            player.pause();
            pause_button.innerHTML = "▶";
        }
    }

    player.addEventListener("ended", () => skip(1));

    // Initialize first track WITHOUT autoplaying
    loadTrack(index);

    // Expose functions for inline onclick handlers if you use them
    window.skip = skip;
    window.play_pause = play_pause;
    window.playAudio = function (x) {
        const a = document.getElementById(x);
        a.paused ? a.play().catch(e => console.warn(e)) : a.pause();
    };
    window.setVolume = function (vol, sounds) {
        document.getElementById(sounds).volume = document.getElementById(vol).value;
    };
});
